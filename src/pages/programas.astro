---
import Base from "../layouts/Base.astro";
import Icono from "../components/Icono.astro";
import { COMPRAR } from "../consts";

// Lista de programas: el Optimizador disponible actualmente y los próximos proyectos en desarrollo.
const programas = [
  {
    id: "optimizador",
    nombre: "Optimizador PfoHardware",
    estado: "disponible",
    etiqueta: "Disponible",
    texto: "Deja tu PC con Windows 10 u 11 más fluida con un clic. Es fácil de usar, se puede deshacer y lo podés volver a usar cada tanto para mantenerla estable y rápida. Y en su engranaje trae más herramientas: desfragmentar y optimizar discos, ver la salud de los discos y de la batería, y saber qué conviene mejorar.",
    imagen: { src: "img/motion/hero-optimizador-final.webp", alt: "El Optimizador al terminar: Optimización completada" },
    conocer: "index.html#optimizador",
    comprar: COMPRAR,
  },
  {
    id: "normalizador",
    nombre: "Normalizador de Bases de Datos",
    estado: "proximamente",
    etiqueta: "Próximamente",
    subtitulo: "Diseño relacional y análisis de dependencias funcionales",
    texto: "Herramienta de escritorio pensada para estudiantes y desarrolladores que necesitan diseñar y normalizar bases de datos relacionales sin complicaciones. Analiza atributos y dependencias, descompone tablas paso a paso hasta 3FN y BCNF para eliminar redundancias y anomalías de actualización, y genera directamente el script SQL limpio y estructurado.",
    icono: "baseDatos",
  },
  {
    id: "organizador",
    nombre: "Organizador de Materias",
    estado: "proximamente",
    etiqueta: "Próximamente",
    subtitulo: "Seguimiento académico, correlatividades y cursada",
    texto: "Aplicación ligera para organizar tu carrera universitaria o terciaria en un solo lugar y de forma 100% offline. Visualizá el árbol de correlatividades para saber qué materias podés cursar o rendir, coordiná horarios semanales, gestioná fechas de parciales y entregas, y llevá el cálculo automático de promedios y avance de tu plan de estudio.",
    icono: "calendario",
  },
];
---
<Base
  titulo="Programas para Windows · PfoHardware"
  descripcion="Los programas de PfoHardware para Windows, hechos por Iván Pfoh. El Optimizador de Sistema y próximos proyectos de software: Normalizador de bases de datos y Organizador de materias."
  ruta="programas.html"
  actual="programas"
>
  <section class="arriba" aria-labelledby="programas-titulo">
    <div class="contenedor">
      <h1 id="programas-titulo" data-titulo><span class="linea"><span>Mis programas</span></span></h1>
      <p class="bajada" data-entra>Programas para Windows que hice y uso en mis propios equipos. Herramientas útiles, livianas y con soporte directo conmigo.</p>

      <ul class="programas">
        {programas.map((p) => (
          <li class:list={["programa", p.estado === "proximamente" && "programa-proximo"]} data-entra>
            {p.imagen ? (
              <img src={p.imagen.src} alt={p.imagen.alt} width="900" height="966" loading="lazy" decoding="async" />
            ) : p.id === "normalizador" ? (
              <div class="programa-preview" aria-hidden="true">
                <div class="preview-barra">
                  <span class="preview-dot"></span>
                  <span class="preview-titulo">Normalizador BD · PfoHardware</span>
                  <span class="preview-botones"><i></i><i></i><i></i></span>
                </div>
                <div class="preview-cuerpo preview-bd">
                  <div class="bd-chip"><Icono nombre="baseDatos" tam={14} /> <span>Análisis relacional</span></div>
                  <div class="bd-tabla">
                    <span class="tabla-cabecera">CLIENTES</span>
                    <span class="tabla-campo pk">🔑 id_cliente (PK)</span>
                    <span class="tabla-campo">nombre, email</span>
                  </div>
                  <div class="bd-conector">
                    <span class="conector-linea"></span>
                    <span class="conector-etiqueta">1 : N</span>
                  </div>
                  <div class="bd-tabla">
                    <span class="tabla-cabecera">PEDIDOS</span>
                    <span class="tabla-campo pk">🔑 id_pedido (PK)</span>
                    <span class="tabla-campo fk">🔗 id_cliente (FK)</span>
                    <span class="tabla-campo">fecha, total</span>
                  </div>
                  <div class="bd-estado">
                    <span class="estado-check">✓</span>
                    <span>Normalizado hasta 3FN / BCNF</span>
                  </div>
                </div>
              </div>
            ) : (
              <div class="programa-preview" aria-hidden="true">
                <div class="preview-barra">
                  <span class="preview-dot"></span>
                  <span class="preview-titulo">Organizador Materias · PfoHardware</span>
                  <span class="preview-botones"><i></i><i></i><i></i></span>
                </div>
                <div class="preview-cuerpo preview-org">
                  <div class="org-progreso">
                    <div class="org-progreso-head">
                      <span>Plan de carrera</span>
                      <strong class="num">68%</strong>
                    </div>
                    <div class="org-barra"><div class="org-barra-fill"></div></div>
                  </div>
                  <div class="org-alerta">
                    <Icono nombre="calendario" tam={16} />
                    <div>
                      <small>Próximo examen</small>
                      <strong>Final: Base de Datos II</strong>
                    </div>
                  </div>
                  <ul class="org-materias">
                    <li class="materia-item aprobada">
                      <span class="materia-icono">✓</span>
                      <span>Algoritmos y Estructuras</span>
                      <small>Aprobada</small>
                    </li>
                    <li class="materia-item cursando">
                      <span class="materia-icono">⏳</span>
                      <span>Sistemas Operativos</span>
                      <small>En curso</small>
                    </li>
                    <li class="materia-item pendiente">
                      <span class="materia-icono">🔒</span>
                      <span>Redes de Datos</span>
                      <small>Correlativa</small>
                    </li>
                  </ul>
                </div>
              </div>
            )}
            <div class="programa-texto">
              <div class="programa-cabecera">
                {p.estado === "proximamente" ? (
                  <span class="badge-proximamente">
                    <span class="punto-pulso" aria-hidden="true"></span>
                    Próximamente
                  </span>
                ) : (
                  <span class="badge-disponible">
                    <span class="punto" aria-hidden="true"></span>
                    Disponible
                  </span>
                )}
                <h2>{p.nombre}</h2>
                {p.subtitulo && <p class="subtitulo">{p.subtitulo}</p>}
              </div>
              <p class="descripcion">{p.texto}</p>
              <div class="acciones">
                {p.comprar ? (
                  <>
                    <a class="boton boton-marca boton-grande" href={p.comprar}>Comprar <Icono nombre="flecha" tam={18} /></a>
                    <a class="boton boton-panel boton-grande" href={p.conocer}>Conocerlo</a>
                  </>
                ) : (
                  <>
                    <span class="estado-desarrollo">
                      <Icono nombre={p.icono as any} tam={18} />
                      En desarrollo para Windows
                    </span>
                    <a class="boton boton-panel" href="contacto.html">
                      Consultar o sugerir ideas <Icono nombre="flecha" tam={16} />
                    </a>
                  </>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="pronto" data-entra>Sigo diseñando y programando nuevas herramientas para Windows. ¿Tenés una idea o necesidad particular? <a class="enlace" href="contacto.html">Escribime</a>.</p>
    </div>
  </section>
</Base>

<style>
  .arriba { padding: calc(var(--header) + clamp(56px, 8vw, 112px)) 0 clamp(72px, 9vw, 128px); background: var(--campo-1); }
  .arriba h1 { font-size: clamp(2.2rem, 5.2vw, 4.8rem); }
  .bajada { margin-top: 24px; max-width: 36em; font-size: 1.15rem; }
  .programas { list-style: none; display: grid; gap: 32px; margin-top: clamp(40px, 5vw, 72px); }
  .programa {
    display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(24px, 4vw, 56px); align-items: center; padding: clamp(22px, 3.5vw, 40px);
    border-radius: var(--radio-ventana); background: var(--panel); border: 1px solid var(--borde);
    transition: border-color 240ms ease;
  }
  .programa:hover { border-color: rgba(31, 221, 245, 0.25); }
  .programa-proximo { background: linear-gradient(145deg, #091013, #070B0E); }
  .programa img {
    width: 100%; max-width: 340px; aspect-ratio: 900 / 966;
    border-radius: var(--radio); border: 1px solid var(--borde); background: var(--fondo);
  }

  /* Vista previa interactiva/mockup estilo Windows para proyectos en desarrollo */
  .programa-preview {
    width: 100%; max-width: 340px; aspect-ratio: 900 / 966;
    border-radius: var(--radio); border: 1px solid var(--borde); background: var(--fondo);
    display: flex; flex-direction: column; overflow: hidden;
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }
  .preview-barra {
    height: 36px; padding: 0 12px; display: flex; align-items: center; gap: 8px;
    background: #070B0D; border-bottom: 1px solid var(--borde); font-size: 12px; color: var(--texto-dim);
  }
  .preview-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--marca-2); }
  .preview-titulo { font-family: var(--letra); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .preview-botones { margin-left: auto; display: flex; gap: 6px; }
  .preview-botones i { width: 8px; height: 8px; border-radius: 50%; background: #243238; display: block; }
  .preview-cuerpo {
    flex: 1; padding: 18px 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;
    background: radial-gradient(circle at 50% 10%, rgba(31, 221, 245, 0.05), transparent 70%);
  }

  /* Elementos visuales del Normalizador de BD */
  .bd-chip {
    display: inline-flex; align-items: center; gap: 6px; font-size: 0.76rem; font-weight: 600;
    color: var(--marca-2); background: rgba(31, 221, 245, 0.08); border: 1px solid rgba(31, 221, 245, 0.22);
    padding: 4px 10px; border-radius: 6px; width: fit-content;
  }
  .bd-tabla {
    background: #0B1418; border: 1px solid #1E343A; border-radius: 8px; padding: 10px 12px;
    display: flex; flex-direction: column; gap: 3px; font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 0.78rem;
  }
  .tabla-cabecera { font-weight: 700; color: var(--marca-1); font-size: 0.8rem; margin-bottom: 2px; }
  .tabla-campo { color: #A0B0B6; }
  .tabla-campo.pk { color: var(--marca-2); font-weight: 600; }
  .tabla-campo.fk { color: #8BE9FD; }
  .bd-conector { display: flex; align-items: center; justify-content: center; gap: 8px; margin: -2px 0; }
  .conector-linea { height: 12px; width: 2px; background: var(--marca-2); opacity: 0.5; }
  .conector-etiqueta { font-size: 0.68rem; color: var(--texto-dim); font-family: monospace; background: #070B0D; padding: 1px 6px; border-radius: 4px; border: 1px solid var(--borde); }
  .bd-estado {
    display: flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 600;
    color: #4ADE80; background: rgba(74, 222, 128, 0.08); border: 1px solid rgba(74, 222, 128, 0.2);
    padding: 6px 10px; border-radius: 6px; margin-top: auto;
  }
  .estado-check { font-weight: 700; }

  /* Elementos visuales del Organizador de Materias */
  .org-progreso {
    background: #0B1418; border: 1px solid #1E343A; border-radius: 8px; padding: 10px 12px;
  }
  .org-progreso-head { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--texto-dim); margin-bottom: 6px; }
  .org-progreso-head strong { color: var(--marca-1); }
  .org-barra { height: 6px; border-radius: 3px; background: #132227; overflow: hidden; }
  .org-barra-fill { width: 68%; height: 100%; border-radius: 3px; background: var(--degrade); }
  .org-alerta {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px;
    background: rgba(31, 221, 245, 0.08); border: 1px solid rgba(31, 221, 245, 0.25);
  }
  .org-alerta small { display: block; font-size: 0.72rem; color: var(--texto-dim); text-transform: uppercase; letter-spacing: 0.05em; }
  .org-alerta strong { font-size: 0.85rem; color: var(--texto); font-weight: 600; }
  .org-materias { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .materia-item {
    display: grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items: center;
    padding: 6px 10px; border-radius: 6px; font-size: 0.78rem; background: #081014; border: 1px solid #142228;
  }
  .materia-item small { font-size: 0.7rem; font-weight: 600; }
  .materia-item.aprobada { color: #E6EDF3; }
  .materia-item.aprobada small { color: #4ADE80; }
  .materia-item.cursando small { color: var(--marca-2); }
  .materia-item.pendiente small { color: var(--texto-dim); }

  /* Textos de la tarjeta */
  .programa-cabecera { display: flex; flex-direction: column; gap: 6px; }
  .programa h2 { font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1.08; }
  .subtitulo { font-size: 1rem; color: var(--marca-suave); font-weight: 600; margin: 0; }
  .descripcion { margin-top: 14px; max-width: 36em; font-size: 1.08rem; color: #C2CBD2; }

  /* Badges de estado */
  .badge-disponible {
    display: inline-flex; align-items: center; gap: 8px; width: fit-content;
    padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
    color: var(--marca-1); background: rgba(0, 245, 160, 0.08); border: 1px solid rgba(0, 245, 160, 0.28);
    margin-bottom: 6px;
  }
  .badge-proximamente {
    display: inline-flex; align-items: center; gap: 8px; width: fit-content;
    padding: 5px 14px; border-radius: 20px; font-size: 0.82rem; font-weight: 700;
    color: var(--marca-2); background: rgba(31, 221, 245, 0.1); border: 1px solid rgba(31, 221, 245, 0.35);
    letter-spacing: 0.02em; margin-bottom: 6px;
  }
  .punto-pulso {
    width: 8px; height: 8px; border-radius: 50%; background: var(--marca-2);
    box-shadow: 0 0 10px var(--marca-2); animation: pulso-luz 2s infinite ease-in-out;
  }
  @keyframes pulso-luz {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 26px; }
  .estado-desarrollo {
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px;
    border-radius: var(--radio); background: #081216; border: 1px solid #1B3239;
    color: var(--marca-2); font-weight: 600; font-size: 0.95rem;
  }

  .pronto { margin-top: 36px; color: var(--texto-dim); font-size: 1.05rem; max-width: 42em; line-height: 1.6; }
  @media (max-width: 900px) {
    .programa { grid-template-columns: 1fr; }
    .programa img, .programa-preview { justify-self: center; }
    .acciones .boton, .estado-desarrollo { flex: 1 1 100%; justify-content: center; text-align: center; }
  }
</style>
